# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Publishable key exposed to the frontend (must start with VITE_)
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...

# ── Burq Delivery ─────────────────────────────────────────────────────────────
BURQ_API_KEY=...
BURQ_BASE_URL=https://api.burq.com/v1
BURQ_WEBHOOK_SECRET=...

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/washwell

# ── Real-time / WebSocket ─────────────────────────────────────────────────────
# Point this at your WebSocket server or a managed service (Pusher, Ably, etc.)
VITE_WEBSOCKET_URL=wss://your-ws-server.com

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
