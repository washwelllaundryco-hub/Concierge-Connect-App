# ── Twilio / WhatsApp ─────────────────────────────────────────────────────────
# Get from twilio.com → Console → Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
# Your Twilio WhatsApp-enabled number (must be approved in Twilio Console)
TWILIO_WHATSAPP_NUMBER=+14155238886
# SMS-capable Twilio number used to send staff notifications (replaces WhatsApp sandbox)
TWILIO_SMS_NUMBER=+1XXXXXXXXXX
# Team numbers to receive WhatsApp alerts
WHATSAPP_TECHNICIAN=+1XXXXXXXXXX
WHATSAPP_CONCIERGE=+1XXXXXXXXXX
WHATSAPP_MANAGER=+1XXXXXXXXXX
# ── Anthropic (AI message composer for WhatsApp notifications) ────────────────
ANTHROPIC_API_KEY=sk-ant-...
# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/washwell
# ── Real-time / WebSocket ─────────────────────────────────────────────────────
VITE_WEBSOCKET_URL=wss://your-ws-server.com
# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
